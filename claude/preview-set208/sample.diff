+# SAMPLE (set 208 preview): tribe chips in a row at the field's top-right · only tribes on the team · count / next step
+func _fill_trow(counts: Dictionary, steps: Dictionary, have: Array) -> void:
+	tribe_col.visible = false
+	if _trow == null:
+		_trow = HBoxContainer.new()
+		_trow.name = "TribeRowSample"
+		_trow.mouse_filter = Control.MOUSE_FILTER_IGNORE
+		_trow.add_theme_constant_override("separation", 6)
+		_trow.alignment = BoxContainer.ALIGNMENT_BEGIN
+		field.add_child(_trow)
+		_trow.anchor_left = 0.0
+		_trow.anchor_right = 0.6
+		_trow.offset_left = 0
+		_trow.offset_right = 0
+		_trow.offset_top = 0
+		_trow.offset_bottom = 52
+	for ch in _trow.get_children():
+		_trow.remove_child(ch)
+		ch.queue_free()
+	var tsteps: Array = R.RULES()["tribeSteps"]
+	for t in have:
+		var n := float(counts[t])
+		var nxt := float(tsteps[-1])
+		for x in tsteps:
+			if n < float(x):
+				nxt = float(x)
+				break
+		var on := float(steps.get(t, 0)) > 0.0
+		var sp: Array = TH.TRIBE_SHAPE.get(t, ["square", "mute"])
+		var colv := VBoxContainer.new()
+		colv.mouse_filter = Control.MOUSE_FILTER_IGNORE
+		colv.add_theme_constant_override("separation", 1)
+		var ring := PanelContainer.new()
+		ring.mouse_filter = Control.MOUSE_FILTER_IGNORE
+		ring.custom_minimum_size = Vector2(30, 30)
+		ring.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
+		ring.add_theme_stylebox_override("panel", TH.box(Color(0.06, 0.05, 0.1, 0.9), TH.c(sp[1]), 15, 2, 0, 0))
+		var sh := SHAPE.make(sp[0], sp[1], 16)
+		sh.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
+		sh.size_flags_vertical = Control.SIZE_SHRINK_CENTER
+		ring.add_child(sh)
+		colv.add_child(ring)
+		var l := TH.label("%s/%s" % [_n(n), _n(nxt)], 13, "ink", "body_b")
+		l.add_theme_color_override("font_color", Color(1.0, 0.85, 0.3) if on else Color(0.92, 0.92, 0.92))
+		l.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.9))
+		l.add_theme_constant_override("outline_size", 4)
+		l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+		l.mouse_filter = Control.MOUSE_FILTER_IGNORE
+		colv.add_child(l)
+		_trow.add_child(colv)
