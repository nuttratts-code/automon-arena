+# SAMPLE ONLY (set 208 preview): padlock drawn in code · locked = gold closed · open = grey open shackle
+extends Control
+var locked := false
+func _draw() -> void:
+	var s := size
+	var w := minf(s.x, s.y) * 0.62
+	var o := (s - Vector2(w, w * 1.15)) / 2.0
+	var body := Rect2(o + Vector2(0, w * 0.5), Vector2(w, w * 0.65))
+	var col := Color(1.0, 0.82, 0.3) if locked else Color(0.85, 0.85, 0.85)
+	var dark := Color(0, 0, 0, 0.85)
+	var c := Vector2(o.x + w / 2.0, body.position.y)
+	var r := w * 0.32
+	var cs := c + (Vector2.ZERO if locked else Vector2(w * 0.28, -w * 0.12))
+	draw_arc(cs, r, PI, TAU, 16, dark, 5.0)
+	draw_arc(cs, r, PI, TAU, 16, col, 2.5)
+	draw_rect(body.grow(1.5), dark)
+	draw_rect(body, col)
+	draw_circle(body.get_center(), w * 0.09, dark)
