+# r38a (owner, set 299): soft light band (v1) runs over the coloured frame + name strip only (never the creature box),
+# each card on its own random timer. S299GLOW=1 on. Real Godot shader (not a mock).
+const GLOW38 := """
+shader_type canvas_item;
+uniform vec2 sz = vec2(100.0, 96.0);
+uniform float y0 = 75.0;
+uniform float prog = -1.0;
+uniform vec3 tl = vec3(1.0);
+uniform vec3 tr = vec3(1.0);
+uniform float peak = 0.55;
+void fragment() {
+	vec2 p = UV * sz;
+	float w = sz.x; float h = sz.y;
+	float dout = min(min(min(p.x, p.y), min(w - p.x, h - p.y)), min(p.x + p.y - 5.0, (w - p.x) + (h - p.y) - 5.0) * 0.7071);
+	float din = min(min(min(p.x - 3.0, p.y - 3.0), min(w - 3.0 - p.x, y0 - 0.5 - p.y)), (p.x + p.y - 9.24) * 0.7071);
+	float m = clamp(dout + 0.5, 0.0, 1.0) * clamp(0.5 - din, 0.0, 1.0);
+	float k = 0.577;
+	float bw = w * 0.18;
+	float c = mix(-bw, w + h * k + bw, prog);
+	float d = (p.x + p.y * k - c) / bw;
+	float a = peak * exp(-4.0 * d * d) * step(0.0, prog);
+	vec3 tint = mix(tl, tr, clamp(p.x / w, 0.0, 1.0));
+	COLOR = vec4(mix(vec3(1.0), tint, 0.35), a * m);
+}
