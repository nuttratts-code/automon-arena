+var _g38: ColorRect = null
+var _gw38 := -1.0
+var _gt38 := -1.0
+
+func _glow38(d: float) -> void:
+	if OS.get_environment("S299SEQDT") != "":
+		d = float(OS.get_environment("S299SEQDT"))
+	if _g38 == null:
+		var sh := Shader.new()
+		sh.code = GLOW38
+		var mt := ShaderMaterial.new()
+		mt.shader = sh
+		_g38 = ColorRect.new()
+		_g38.material = mt
+		_g38.mouse_filter = Control.MOUSE_FILTER_IGNORE
+		_g38.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+		add_child(_g38)
+		_gw38 = randf_range(0.3, 4.0)
+		var cols: Array = get_meta("cols", [])
+		var st := _stops2(cols, get_meta("rc", Color(0.5, 0.5, 0.5)), get_meta("pw", 22.0))
