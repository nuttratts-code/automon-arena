+# r36l (owner): shop card top + bottom edges = the top plate's own edges — the card draws only its sides and cut corners,
+# the plate's line is the card's top/bottom line (no doubled line)
+static func col(ci: CanvasItem, w: float, h: float, on: bool, a: float, edge: Variant, ew: float) -> void:
+	var pl := TEAM._pl299()
+	var k := 6.0
+	var p := _pts(Rect2(0, 0, w, h), k, k)
+	var fill: Color = Color(pl[1], pl[3] * a) if on else Color(pl[0], pl[2] * a)
+	_fill299(ci, p, 0.0, h, fill)
+	var dk := Color(0.05, 0.05, 0.06, 0.85 * a)
+	ci.draw_line(Vector2(-1, k), Vector2(-1, h), dk, 1.0)
+	ci.draw_line(Vector2(w + 1, 0), Vector2(w + 1, h - k), dk, 1.0)
+	var ec: Color = Color(pl[4], (pl[5] + 0.38 if on else pl[5]) * a) if edge == null else edge
+	ci.draw_polyline(PackedVector2Array([Vector2(0, h), Vector2(0, k), Vector2(k, 0)]), ec, ew)
+	ci.draw_polyline(PackedVector2Array([Vector2(w, 0), Vector2(w, h - k), Vector2(w - k, h)]), ec, ew)
