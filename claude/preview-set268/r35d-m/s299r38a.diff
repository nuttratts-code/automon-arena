+# r38a (owner, set 299): the r36w frame was a 3 px polyline (cut 5 at inset 1.5) + lines with their own cuts, so the gap
+# on the diagonals differed from the sides (black wedge inside top-left, notch at the bottom-right). Now every line at
+# inset i uses cut c(i) = 5 - 0.586 i (= same perpendicular distance as the sides) and the frame is a filled ring.
+static func _c38(i: float) -> float:
+	return 5.0 - (2.0 - sqrt(2.0)) * i
+
+func _ring38(st: Array, y0: float, mode: int) -> void:
+	var w := size.x
+	var hh := size.y
+	var r0 := Rect2(Vector2.ZERO, size)
+	var po := _pts(r0, _c38(0.0), _c38(0.0))
