+			_card_shine(cols, rc, pw, h, card, maxi(1, int(OS.get_environment("S299SHINE"))))
+			return
+		if one == "4":   # r36v: strip = frame colour, one piece
+			if card:
+				_recess()
+			_strip_one(cols, rc, pw, h, card)
+			return
+		if one != "0":   # r36t: frame + strip one piece
+			if card:
+				if one == "2":
+					_recess_col(cols, rc, pw)
+				else:
+					_recess()
+			draw_set_transform(Vector2(0, size.y - h))
+			_foot2b(cols, rc, pw, w, h)
+			draw_set_transform(Vector2.ZERO)
+			if card:
+				if one == "3":
+					_frame_dark(cols, rc, pw, h)
+				else:
+					_frame_one(cols, rc, pw, h)
+			return
+		if card:
+			_recess()
+		draw_set_transform(Vector2(0, size.y - h))
+		_foot2b(cols, rc, pw, w, h)
+		draw_set_transform(Vector2.ZERO)
+		if card:
+			_frame2(cols, rc, pw)
+		return
+	if OS.get_environment("S299CARD") == "1":   # r36r: recess + coloured frame (whole card, before the strip)
+		_card_deco(cols, rc, pw)
+	draw_set_transform(Vector2(0, size.y - h))   # _ready forces full rect: draw the strip at the bottom
+	if fv == 2:   # r36r: one smooth blend
+		_foot2(cols, rc, pw, w, h)
+		draw_set_transform(Vector2.ZERO)
+		return
+	var sl := 5.0
+	var lw := w - pw
+	var bands := []
+	for i in cols.size():
+		bands.append([lw * i / cols.size(), lw * (i + 1) / cols.size(), cols[i]])
+	bands.append([lw, w, rc])
+	var nb := bands.size()
+	var k := 5.0   # the card's bottom-right cut
+	for i in nb:
+		var x0: float = bands[i][0]
+		var x1: float = bands[i][1]
+		var c: Color = (bands[i][2] as Color).darkened(0.42)
+		c.a = 0.94
+		var x0t := x0 + (sl * 0.5 if i > 0 else 0.0)
+		var x0b := x0 - (sl * 0.5 if i > 0 else 0.0)
+		var x1t := x1 + (sl * 0.5 if i < nb - 1 else 0.0)
+		var x1b := x1 - (sl * 0.5 if i < nb - 1 else 0.0)
+		var p := PackedVector2Array([Vector2(x0t, 0), Vector2(x1t, 0)])
+		if i == nb - 1:
+			p.append_array([Vector2(w, h - k), Vector2(w - k, h)])
+		else:
+			p.append(Vector2(x1b, h))
+		p.append(Vector2(x0b, h))
+		var top := c.lightened(0.12)
+		var bot := c.darkened(0.12)
+		var cc := PackedColorArray()
+		for q in p:
+			cc.append(top.lerp(bot, q.y / maxf(1.0, h)))
+		draw_polygon(p, cc)
+	if fv == 2:   # soft: blend each boundary over 12 px
+		for i in nb - 1:
+			var xb: float = bands[i][1]
+			var ca: Color = (bands[i][2] as Color).darkened(0.42)
+			var cb: Color = (bands[i + 1][2] as Color).darkened(0.42)
+			ca.a = 0.94
+			cb.a = 0.94
+			draw_polygon(PackedVector2Array([Vector2(xb - 6, 0), Vector2(xb + 6, 0), Vector2(xb + 6, h), Vector2(xb - 6, h)]),
+				PackedColorArray([ca, cb, cb, ca]))
+	if fv == 3:   # dark divider + light top line
+		for i in nb - 1:
+			var xb: float = bands[i][1]
+			draw_line(Vector2(xb + sl * 0.5, 0), Vector2(xb - sl * 0.5, h), Color(0.02, 0.03, 0.04, 0.9), 1.5)
+		draw_line(Vector2(0, 0.5), Vector2(w, 0.5), Color(1, 1, 1, 0.35), 1.0)
+	else:
+		draw_line(Vector2(0, 0.5), Vector2(w, 0.5), Color(0, 0, 0, 0.6), 1.0)
+
+func _stops(cols: Array, rc: Color, pw: float, w: float) -> Array:   # r36r: [x, colour] at each shade's centre
+	var lw := w - pw
+	var st := [[0.0, cols[0] if cols.size() > 0 else rc]]
+	for i in cols.size():
+		st.append([lw * (i + 0.5) / cols.size(), cols[i]])
+	st.append([lw + pw * 0.5, rc])
+	st.append([w, rc])
+	return st
+
+func _col_at(st: Array, x: float) -> Color:
+	for i in st.size() - 1:
+		var a: Array = st[i]
+		var b: Array = st[i + 1]
+		if x <= float(b[0]):
+			var t := clampf((x - float(a[0])) / maxf(0.001, float(b[0]) - float(a[0])), 0.0, 1.0)
+			t = t * t * (3.0 - 2.0 * t)   # smoothstep: no hard seam
+			return (a[1] as Color).lerp(b[1] as Color, t)
+	return st[st.size() - 1][1]
+
+func _foot2(cols: Array, rc: Color, pw: float, w: float, h: float) -> void:   # r36r: smooth blend strip
+	var st := _stops(cols, rc, pw, w)
+	var k := 5.0
+	var n := 24
+	for i in n:
+		var x0 := w * i / n
+		var x1 := w * (i + 1) / n
+		var c0 := _col_at(st, x0).darkened(0.42)
+		var c1 := _col_at(st, x1).darkened(0.42)
+		c0.a = 0.94
+		c1.a = 0.94
+		var p := PackedVector2Array([Vector2(x0, 0), Vector2(x1, 0)])
+		var cc := PackedColorArray([c0, c1])
+		if x1 > w - k:   # the card's bottom-right cut
+			var yb := h - (x1 - (w - k))
+			p.append_array([Vector2(x1, yb)])
+			cc.append(c1)
+			if x0 > w - k:
+				p.append(Vector2(x0, h - (x0 - (w - k))))
+				cc.append(c0)
+			else:
+				p.append_array([Vector2(w - k, h), Vector2(x0, h)])
+				cc.append_array([_col_at(st, w - k).darkened(0.42), c0])
+		else:
+			p.append_array([Vector2(x1, h), Vector2(x0, h)])
+			cc.append_array([c1, c0])
+		draw_polygon(p, cc)
+	draw_polygon(PackedVector2Array([Vector2(0, 0), Vector2(w, 0), Vector2(w, h * 0.5), Vector2(0, h * 0.5)]),
+		PackedColorArray([Color(1, 1, 1, 0.10), Color(1, 1, 1, 0.10), Color(1, 1, 1, 0), Color(1, 1, 1, 0)]))
+	draw_line(Vector2(0, 0.5), Vector2(w, 0.5), Color(0, 0, 0, 0.55), 1.0)
+
+func _card_deco(cols: Array, rc: Color, pw: float) -> void:   # r36r: creature sits deeper + frame in the card's colours
+	var w := size.x
+	var h := size.y
+	var sh := Color(0, 0, 0, 0.6)
+	var z := Color(0, 0, 0, 0)
+	var d := 14.0
+	draw_polygon(PackedVector2Array([Vector2(0, 0), Vector2(w, 0), Vector2(w, d), Vector2(0, d)]), PackedColorArray([sh, sh, z, z]))
+	draw_polygon(PackedVector2Array([Vector2(0, 0), Vector2(d, 0), Vector2(d, h), Vector2(0, h)]), PackedColorArray([sh, z, z, sh]))
+	draw_polygon(PackedVector2Array([Vector2(w - d, 0), Vector2(w, 0), Vector2(w, h), Vector2(w - d, h)]), PackedColorArray([z, sh, sh, z]))
+	var st := _stops(cols, rc, pw, w)
+	var p := _pts(Rect2(Vector2.ZERO, size).grow(-1.0), 5.0, 5.0)
+	p.append(p[0])
+	var cv := PackedColorArray()
+	for q in p:
+		var c := _col_at(st, q.x).lightened(0.10)
+		c.a = 0.95
+		cv.append(c)
+	draw_polyline_colors(p, cv, 2.0)
+	var pi := _pts(Rect2(Vector2.ZERO, size).grow(-3.0), 4.0, 4.0)
+	pi.append(pi[0])
+	draw_polyline(pi, Color(0, 0, 0, 0.55), 1.0)
+
+func _col_lin(st: Array, x: float) -> Color:   # r36s: blend in linear light (no grey middle)
+	for i in st.size() - 1:
+		var a: Array = st[i]
+		var b: Array = st[i + 1]
+		if x <= float(b[0]):
+			var t := clampf((x - float(a[0])) / maxf(0.001, float(b[0]) - float(a[0])), 0.0, 1.0)
+			t = t * t * (3.0 - 2.0 * t)
+			return (a[1] as Color).srgb_to_linear().lerp((b[1] as Color).srgb_to_linear(), t).linear_to_srgb()
+	return st[st.size() - 1][1]
+
+func _foot2b(cols: Array, rc: Color, pw: float, w: float, h: float) -> void:   # r36s
+	var lw := w - pw
+	var st := [[0.0, cols[0] if cols.size() > 0 else rc]]   # wide stops: tribe 1 fills the left, rarity the price end
+	if cols.size() > 1:
+		for i in cols.size():
+			st.append([lw * (0.15 + 0.7 * i / (cols.size() - 1)), cols[i]])
+	else:
+		st.append([lw * 0.35, st[0][1]])
+	st.append([w - pw * 0.4, rc])
+	st.append([w, rc])
+	var f := 10.0   # fade up into the art
+	var k := 5.0    # bottom-right cut
+	var ys := [-f, -f * 0.6, -f * 0.25, 0.0, h]
+	var al := [0.0, 0.22, 0.6, 0.92, 0.94]
+	var n := 64
+	for i in n:
+		var x0 := w * i / n
+		var x1 := w * (i + 1) / n
+		var b0 := h - maxf(0.0, x0 - (w - k))
+		var b1 := h - maxf(0.0, x1 - (w - k))
+		var c0 := _col_lin(st, x0)
+		var c1 := _col_lin(st, x1)
+		for r in ys.size() - 1:
+			var ya: float = ys[r]
+			var yb: float = ys[r + 1]
+			var yb0 := minf(yb, b0)
+			var yb1 := minf(yb, b1)
+			var ca0 := _shade(c0, ya, h, al[r])
+			var ca1 := _shade(c1, ya, h, al[r])
+			var cb0 := _shade(c0, yb0, h, al[r + 1])
+			var cb1 := _shade(c1, yb1, h, al[r + 1])
+			draw_polygon(PackedVector2Array([Vector2(x0, ya), Vector2(x1, ya), Vector2(x1, yb1), Vector2(x0, yb0)]),
+				PackedColorArray([ca0, ca1, cb1, cb0]))
+
+func _shade(c: Color, y: float, h: float, a: float) -> Color:   # r36s: lit top -> darker bottom inside the strip
+	var t := clampf(y / h, 0.0, 1.0)
+	var o := c.darkened(lerpf(0.32, 0.52, t))
+	o.a = a
+	return o
+
+func _recess() -> void:   # r36s: r36r inner shadow only
+	var w := size.x
+	var h := size.y
+	var sh := Color(0, 0, 0, 0.6)
+	var z := Color(0, 0, 0, 0)
+	var d := 14.0
+	draw_polygon(PackedVector2Array([Vector2(0, 0), Vector2(w, 0), Vector2(w, d), Vector2(0, d)]), PackedColorArray([sh, sh, z, z]))
+	draw_polygon(PackedVector2Array([Vector2(0, 0), Vector2(d, 0), Vector2(d, h), Vector2(0, h)]), PackedColorArray([sh, z, z, sh]))
+	draw_polygon(PackedVector2Array([Vector2(w - d, 0), Vector2(w, 0), Vector2(w, h), Vector2(w - d, h)]), PackedColorArray([z, sh, sh, z]))
+
+func _frame2(cols: Array, rc: Color, pw: float) -> void:   # r36s: frame after the strip, colour every 2 px
+	var lw := size.x - pw
+	var st := [[0.0, cols[0] if cols.size() > 0 else rc]]
+	if cols.size() > 1:
+		for i in cols.size():
+			st.append([lw * (0.15 + 0.7 * i / (cols.size() - 1)), cols[i]])
+	else:
+		st.append([lw * 0.35, st[0][1]])
+	st.append([size.x - pw * 0.4, rc])
+	st.append([size.x, rc])
+	var p := _pts(Rect2(Vector2.ZERO, size).grow(-1.0), 5.0, 5.0)
+	p.append(p[0])
+	var q := PackedVector2Array()
+	for i in p.size() - 1:
+		var a: Vector2 = p[i]
+		var b: Vector2 = p[i + 1]
+		var m := maxi(1, int(a.distance_to(b) / 2.0))
+		for j in m:
+			q.append(a.lerp(b, float(j) / m))
+	q.append(p[p.size() - 1])
+	var cv := PackedColorArray()
+	for v in q:
+		var c := _col_lin(st, v.x).lightened(0.10)
+		c.a = 0.95
+		cv.append(c)
+	draw_polyline_colors(q, cv, 2.0)
+	var pi := _pts(Rect2(Vector2.ZERO, size).grow(-3.0), 4.0, 4.0)
+	pi.append(pi[0])
+	draw_polyline(pi, Color(0, 0, 0, 0.35), 1.0)
+
+func _stops2(cols: Array, rc: Color, pw: float) -> Array:   # r36t: same stops as _foot2b
+	var lw := size.x - pw
+	var st := [[0.0, cols[0] if cols.size() > 0 else rc]]
+	if cols.size() > 1:
+		for i in cols.size():
+			st.append([lw * (0.15 + 0.7 * i / (cols.size() - 1)), cols[i]])
+	else:
+		st.append([lw * 0.35, st[0][1]])
+	st.append([size.x - pw * 0.4, rc])
+	st.append([size.x, rc])
+	return st
+
+func _frame_one(cols: Array, rc: Color, pw: float, h: float) -> void:   # r36t: frame in the strip's own shade
+	var st := _stops2(cols, rc, pw)
+	var y0 := size.y - h
+	var p := _pts(Rect2(Vector2.ZERO, size).grow(-1.5), 5.0, 5.0)
+	p.append(p[0])
+	var q := PackedVector2Array()
+	for i in p.size() - 1:
+		var a: Vector2 = p[i]
+		var b: Vector2 = p[i + 1]
+		var m := maxi(1, int(a.distance_to(b) / 2.0))
+		for j in m:
+			q.append(a.lerp(b, float(j) / m))
+	q.append(p[p.size() - 1])
+	var cv := PackedColorArray()
+	for v in q:
+		var c := _shade(_col_lin(st, v.x), v.y - y0, h, 0.94)
+		cv.append(c)
+	draw_polyline_colors(q, cv, 3.0)
+
+func _recess_col(cols: Array, rc: Color, pw: float) -> void:   # r36t S299ONE=2: inner shadow in the card's colours
+	var st := _stops2(cols, rc, pw)
+	var w := size.x
+	var h := size.y
+	var d := 14.0
+	var n := 32
+	for i in n:
+		var x0 := w * i / n
+		var x1 := w * (i + 1) / n
+		var c0 := _col_lin(st, x0).darkened(0.45)
+		var c1 := _col_lin(st, x1).darkened(0.45)
+		c0.a = 0.7
+		c1.a = 0.7
+		var z0 := Color(c0, 0.0)
+		var z1 := Color(c1, 0.0)
+		draw_polygon(PackedVector2Array([Vector2(x0, 0), Vector2(x1, 0), Vector2(x1, d), Vector2(x0, d)]), PackedColorArray([c0, c1, z1, z0]))
+	var cl := _col_lin(st, 0.0).darkened(0.45)
+	var cr := _col_lin(st, w).darkened(0.45)
+	cl.a = 0.7
+	cr.a = 0.7
+	draw_polygon(PackedVector2Array([Vector2(0, 0), Vector2(d, 0), Vector2(d, h), Vector2(0, h)]), PackedColorArray([cl, Color(cl, 0.0), Color(cl, 0.0), cl]))
+	draw_polygon(PackedVector2Array([Vector2(w - d, 0), Vector2(w, 0), Vector2(w, h), Vector2(w - d, h)]), PackedColorArray([Color(cr, 0.0), cr, cr, Color(cr, 0.0)]))
+
+func _frame_dark(cols: Array, rc: Color, pw: float, h: float) -> void:   # r36u: darker frame + black inner line
+	var st := _stops2(cols, rc, pw)
+	var y0 := size.y - h
+	var p := _pts(Rect2(Vector2.ZERO, size).grow(-1.5), 5.0, 5.0)
+	p.append(p[0])
+	var q := PackedVector2Array()
+	for i in p.size() - 1:
+		var a: Vector2 = p[i]
+		var b: Vector2 = p[i + 1]
+		var m := maxi(1, int(a.distance_to(b) / 2.0))
+		for j in m:
+			q.append(a.lerp(b, float(j) / m))
+	q.append(p[p.size() - 1])
+	var cv := PackedColorArray()
+	for v in q:
+		var c := _shade(_col_lin(st, v.x), v.y - y0, h, 1.0).darkened(0.35)
+		cv.append(c)
+	draw_polyline_colors(q, cv, 3.0)
+	var pi := _pts(Rect2(Vector2.ZERO, size).grow(-3.75), 4.0, 4.0)
+	pi.append(pi[0])
+	draw_polyline(pi, Color(0, 0, 0, 0.9), 1.5)
+
+func _fcol(st: Array, x: float, a: float) -> Color:   # r36v: the frame colour (r36s frame)
+	var c := _col_lin(st, x).lightened(0.10)
+	c.a = a
+	return c
+
+func _strip_one(cols: Array, rc: Color, pw: float, h: float, card: bool) -> void:   # r36v
+	var st := _stops2(cols, rc, pw)
+	var w := size.x
+	var y0 := size.y - h
+	var f := 10.0
+	var k := 5.0
+	var ys := [-f, -f * 0.6, -f * 0.25, 0.0, h]
+	var al := [0.0, 0.22, 0.6, 0.95, 0.95]
+	var n := 64
+	for i in n:
+		var x0 := w * i / n
+		var x1 := w * (i + 1) / n
+		var b0 := h - maxf(0.0, x0 - (w - k))
+		var b1 := h - maxf(0.0, x1 - (w - k))
+		for r in ys.size() - 1:
+			var ya: float = ys[r]
+			var yb: float = ys[r + 1]
+			draw_polygon(PackedVector2Array([Vector2(x0, y0 + ya), Vector2(x1, y0 + ya), Vector2(x1, y0 + minf(yb, b1)), Vector2(x0, y0 + minf(yb, b0))]),
+				PackedColorArray([_fcol(st, x0, al[r]), _fcol(st, x1, al[r]), _fcol(st, x1, al[r + 1]), _fcol(st, x0, al[r + 1])]))
+	if not card:
+		return
+	var p := _pts(Rect2(Vector2.ZERO, size).grow(-1.0), 5.0, 5.0)
+	p.append(p[0])
+	var q := PackedVector2Array()
+	for i in p.size() - 1:
+		var a: Vector2 = p[i]
+		var b: Vector2 = p[i + 1]
+		var m := maxi(1, int(a.distance_to(b) / 2.0))
+		for j in m:
+			q.append(a.lerp(b, float(j) / m))
+	q.append(p[p.size() - 1])
+	var cv := PackedColorArray()
+	for v in q:
+		cv.append(_fcol(st, v.x, 0.95))
+	draw_polyline_colors(q, cv, 2.0)
+	# dark inner line: top + sides only, fading out before the strip
+	var e := 3.0
+	var yf := y0 - f
+	var line := PackedVector2Array([Vector2(e, yf), Vector2(e, yf - f), Vector2(e, e + 4.0), Vector2(e + 4.0, e),
+		Vector2(w - e, e), Vector2(w - e, yf - f), Vector2(w - e, yf)])
+	var dk := Color(0, 0, 0, 0.55)
+	var lc := PackedColorArray([Color(0, 0, 0, 0), dk, dk, dk, dk, dk, Color(0, 0, 0, 0)])
+	draw_polyline_colors(line, lc, 1.0)
+
+func _boost(c: Color) -> Color:   # r36w: richer colour
+	return Color.from_hsv(c.h, minf(1.0, c.s * 1.25), minf(1.0, c.v * 1.1), 1.0)
+
+func _metal(c: Color, y: float) -> Color:   # r36w: one ramp over the whole card height
+	var t := clampf(y / size.y, 0.0, 1.0)
+	return c.lightened(0.12 * (1.0 - t)) if t < 0.5 else c.darkened(0.28 * (t - 0.5) * 2.0)
+
+func _cs(st: Array, x: float, y: float) -> Color:
+	return _metal(_boost(_col_lin(st, x)), y)
+
+func _card_shine(cols: Array, rc: Color, pw: float, h: float, card: bool, mode: int) -> void:   # r36w
+	var st := _stops2(cols, rc, pw)
+	var w := size.x
+	var y0 := size.y - h
+	var k := 5.0
+	var n := 64
+	var rows := 6
+	for i in n:   # strip: opaque, hard top edge
+		var x0 := w * i / n
+		var x1 := w * (i + 1) / n
+		var b0 := size.y - maxf(0.0, x0 - (w - k))
+		var b1 := size.y - maxf(0.0, x1 - (w - k))
+		for r in rows:
+			var ya := y0 + h * r / rows
+			var yb := y0 + h * (r + 1) / rows
+			draw_polygon(PackedVector2Array([Vector2(x0, ya), Vector2(x1, ya), Vector2(x1, minf(yb, b1)), Vector2(x0, minf(yb, b0))]),
+				PackedColorArray([_cs(st, x0, ya), _cs(st, x1, ya), _cs(st, x1, minf(yb, b1)), _cs(st, x0, minf(yb, b0))]))
+	var bev := PackedVector2Array()
+	var bc := PackedColorArray()
+	for i in 33:   # light bevel line on the strip's top edge
+		var x := 3.0 + (w - 6.0) * i / 32.0
