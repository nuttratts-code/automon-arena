+		var a1: Vector2 = po[(i + 1) % po.size()]
+		var b0: Vector2 = pin[i]
+		var b1: Vector2 = pin[(i + 1) % pin.size()]
+		var m := maxi(1, int(a0.distance_to(a1) / 2.0))
+		for j in m:
+			var u0 := float(j) / m
+			var u1 := float(j + 1) / m
