# Helpers the battle port needs from src/core/rules.js + src/core/boss.js + src/core/stage.js (set 194, plan P2 step 5b),
# plus JS-behaviour helpers. Game constants come from res://data/game.json (generated by src/tools/exportdata.mjs).
# Number rule for every port: game numbers stay float (= JS double), so floor/ceil/* give the same bits as JS
# and there is no GDScript int/int division. Only hashing / rng work on ints.
# A change in a ported core function must be made in both (src/core/rules.js · boss.js · stage.js carry the note).
extends RefCounted

const GAME_JSON := "res://data/game.json"
static var _gd: Dictionary = {}

static func game() -> Dictionary:
	if _gd.is_empty():
		var d: Variant = JSON.parse_string(FileAccess.open(GAME_JSON, FileAccess.READ).get_as_text())
		assert(d is Dictionary and d.get("modules") is Dictionary, "game.json has the wrong shape")
		_gd = d
	return _gd

static func mod(name: String) -> Dictionary:
	return game()["modules"][name]

static func RULES() -> Dictionary:
	return mod("rules")["RULES"]

static func DO_INFO() -> Dictionary:
	return mod("rules")["DO_INFO"]

# ---- rules.js ----
# upGain: "+%" that gains rounds down but gives at least +1 when pct > 0 and base > 0
static func up_gain(base: float, pct: float) -> float:
	var g := floorf(base * pct / 100.0)
	return 1.0 if g < 1.0 and pct > 0.0 and base > 0.0 else g

# upMul: base × m rounded down; a multiplier > 1 always adds at least 1
static func up_mul(base: float, m: float) -> float:
	var r := floorf(base * m)
	return base + 1.0 if m > 1.0 and base > 0.0 and r <= base else r

const _AT_ROWS := ["front", "mid", "back"]
static func at_match(at: Dictionary, my_row: float, my_lane: float, row: float, lane: float) -> bool:
	return (at.get("row") == "any" or float(_AT_ROWS.find(at.get("row"))) == row) \
		and (at.get("lane") == "both" or (at.get("lane") == "same") == (lane == my_lane))

# ---- boss.js ----
# Which phase is live after `gone` bars have been emptied (phases sorted by `at`)
static func phase_index_at(phases: Array, gone: float) -> int:
	var i := 0
	for j in phases.size():
		if float(phases[j].get("at", 0)) <= gone:
			i = j
	return i

# Live rules of a phase as { id: rule }
static func rule_map(phase: Variant) -> Dictionary:
	var m := {}
	if phase is Dictionary and phase.get("rules") is Array:
		for r in phase["rules"]:
			m[r["id"]] = r
	return m

# Phase-change effects as { id: v }
static func fx_map(phase: Variant) -> Dictionary:
	var m := {}
	if phase is Dictionary and phase.get("fx") is Array:
		for f in phase["fx"]:
			m[f["id"]] = f.get("v")
	return m

# stage.js spotInfo: spot id → { bits, move } or null
static func spot_info(spot: Variant) -> Variant:
	if spot is String and spot == "move":
		return {"bits": "111111", "move": true}
	for p in mod("stage")["BOSS_SPOT_PRESETS"]:
		if p[0] == spot:
			return {"bits": p[2], "move": false}
	if not spot is String or spot.length() != 7 or not (spot[0] == "c" or spot[0] == "m"):
		return null
	var n := 0
	for i in range(1, 7):
		if spot[i] == "1":
			n += 1
		elif spot[i] != "0":
			return null
	var move: bool = spot[0] == "m"
	return {"bits": spot.substr(1), "move": move} if n >= (2 if move else 1) else null

static func slots_of(bits: String) -> Array:
	var out := []
	for i in bits.length():
		if bits[i] == "1":
			out.append(float(i))
	return out

static func spot_cells(spot: Variant) -> Variant:
	var si: Variant = spot_info(spot)
	if si == null:
		return null
	var slots := slots_of(si["bits"])
	if slots.is_empty():
		return null
	return {"slots": slots, "cells": [slots[0]] if si["move"] else slots.duplicate(), "move": si["move"]}

# ---- JS behaviour ----
# Math.round: nearest, .5 goes up (toward +∞) — GDScript round() goes away from zero on negatives
static func js_round(x: float) -> float:
	var r := floorf(x)
	return r + 1.0 if x - r >= 0.5 else r

# Array.prototype.sort is stable; Godot's sort_custom is not. Merge sort with less(a, b) -> bool
# meaning "a before b" (= JS comparator < 0). Returns a new array.
static func stable_sort(arr: Array, less: Callable) -> Array:
	if arr.size() < 2:
		return arr.duplicate()
	var mid := arr.size() >> 1
	var a := stable_sort(arr.slice(0, mid), less)
	var b := stable_sort(arr.slice(mid), less)
	var out := []
	var i := 0
	var j := 0
	while i < a.size() and j < b.size():
		if less.call(b[j], a[i]):  # take from b only when strictly before → ties keep a's (earlier) order
			out.append(b[j])
			j += 1
		else:
			out.append(a[i])
			i += 1
	out.append_array(a.slice(i))
	out.append_array(b.slice(j))
	return out

# JS comparator (returns number, < 0 = a first) → stable sort
static func sort_cmp(arr: Array, cmp: Callable) -> Array:
	return stable_sort(arr, func(x, y): return cmp.call(x, y) < 0)

# ---- JS value helpers (set 195, step 6a) ----
# Number checks like validate.js: JSON numbers arrive as float; bool/String/null are not numbers
static func is_num(x: Variant) -> bool:
	return (x is float or x is int) and is_finite(float(x))

# Number.isInteger
static func is_int(x: Variant) -> bool:
	return is_num(x) and floorf(float(x)) == float(x)

# JS === for JSON values: numbers by value, everything else same type + equal
static func js_seq(a: Variant, b: Variant) -> bool:
	if is_num(a) and is_num(b):
		return float(a) == float(b)
	return typeof(a) == typeof(b) and a == b

# JS String(x) for JSON values (a missing key = "undefined" is the caller's job: see js_str_of)
static func js_str(x: Variant) -> String:
	if x == null:
		return "null"
	if x is bool:
		return "true" if x else "false"
	if x is int or x is float:
		return js_num(float(x))
	if x is String:
		return x
	if x is Array:
		var parts := []
		for v in x:
			parts.append("" if v == null else js_str(v))
		return ",".join(parts)
	return "[object Object]"

# String(d[k]) where a missing key is JS undefined
static func js_str_of(d: Variant, k: String) -> String:
	if not (d is Dictionary) or not d.has(k):
		return "undefined"
	return js_str(d[k])

# JS number → text: whole numbers without ".0", others the shortest text that reads back the same
static func js_num(x: float) -> String:
	if is_nan(x):
		return "NaN"
	if is_inf(x):
		return "Infinity" if x > 0 else "-Infinity"
	if floorf(x) == x and absf(x) < 1e21:
		return "%d" % int(x) if absf(x) < 9.2e18 else String.num(x, 0)
	for p in range(1, 18):
		var s := String.num(x, p)
		if s.to_float() == x:
			return s
	return String.num(x, 17)

# rules.js cleanTags: drop control chars < > , · trim · ≤ TAG_LEN chars · no repeats / skill-kind names · ≤ TAG_MAX
static func clean_tags(list: Variant) -> Array:
	if not (list is Array):
		return []
	var M := mod("rules")
	var out := []
	for t in list:
		if not (t is String):
			continue
		var x := ""
		for ch in t:
			var c: int = ch.unicode_at(0)
			if c < 0x20 or c == 0x7f or ch == "<" or ch == ">" or ch == ",":
				continue
			x += ch
		x = x.strip_edges().left(int(M["TAG_LEN"]))
		if x != "" and not out.has(x) and not M["SKILL_KINDS"].has(x) and x != "ตอน down":
			out.append(x)
		if out.size() >= int(M["TAG_MAX"]):
			break
	return out

# rules.js sameTribeOk / skipSameIdOk
static func same_tribe_ok(s: Dictionary) -> bool:
	var M := mod("rules")
	var to: Variant = s.get("to")
	return s.get("do") == "reviveDowned" or (not ["self", "tribeAllies", "nextTribeBuy"].has(to) and s.get("do") != "shareArmor" \
		and (M["ALLY_T"].has(to) or M["SHOP_T"].has(to)))

static func skip_same_id_ok(s: Dictionary) -> bool:
	var M := mod("rules")
	var to: Variant = s.get("to")
	var info: Variant = M["DO_INFO"].get(s.get("do")) if s.get("do") is String else null
	return not ["self", "nextTribeBuy"].has(to) and s.get("do") != "shareArmor" and info != null and info.get("side") != "self" \
		and (M["ALLY_T"].has(to) or M["SHOP_T"].has(to))
